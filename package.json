{
  "name": "trustlayer-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TrustLayer API: AI credit scoring + onchain credential registry",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js --network chain",
    "build:mock": "node scripts/build-mock.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "serverless-http": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@openzeppelin/contracts": "^5.0.2",
    "hardhat": "^2.22.0"
  }
}